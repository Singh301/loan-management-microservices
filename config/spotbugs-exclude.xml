<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      JPA entity association: RefreshToken.user is an intentional managed
      entity reference used for persistence and lazy loading. SpotBugs reports
      the same exposure through Lombok-generated accessors and constructor.
    -->
    <Match>
        <Class name="com.loanmanagement.auth.entity.RefreshToken"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!--
      Lombok generates RefreshToken$RefreshTokenBuilder as a nested class.
      Match it explicitly because SpotBugs reports the builder method against
      the generated nested class rather than the enclosing entity class.
    -->
    <Match>
        <Class name="com.loanmanagement.auth.entity.RefreshToken$RefreshTokenBuilder"/>
        <Method name="user"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
