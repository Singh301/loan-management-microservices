# Local Docker Compose configuration
# Copy this file to .env and replace every value with your own local secret.

MYSQL_ROOT_PASSWORD=change-me-root-password
DB_USERNAME=root
DB_PASSWORD=change-me-db-password
DB_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Minimum 32 characters for HS256.
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000


# Redis (local defaults; enable TLS/auth in production)
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# Kafka (local defaults; use SASL_SSL and credentials in production)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=https
