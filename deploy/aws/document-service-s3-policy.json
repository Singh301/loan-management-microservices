{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDocumentPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_DOCUMENT_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "documents/*"
          ]
        }
      }
    },
    {
      "Sid": "ManageDocumentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_DOCUMENT_BUCKET/documents/*"
    }
  ]
}
